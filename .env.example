# PostgreSQL(+pgvector) 연결 URL. docker-compose의 기본 postgres 서비스와 일치.
DOCS_MCP_DATABASE_URL=postgresql+psycopg://docs_mcp:docs_mcp@localhost:5432/docs_mcp

# 임베딩 벡터 차원. api_chunk.embedding(pgvector) 컬럼 생성 시 고정되므로
# 변경 시 alembic 마이그레이션(컬럼 재생성 + 재색인)이 필요하다.
DOCS_MCP_EMBEDDING_DIM=256

# 하이브리드 검색에서 키워드 점수 가중치 (0.0=벡터만, 1.0=키워드만).
DOCS_MCP_HYBRID_ALPHA=0.4

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR).
DOCS_MCP_LOG_LEVEL=INFO

# Gemini API 키. 비워두면 임베딩이 HashEmbeddingProvider(결정적 해시 기반)로 폴백된다.
DOCS_MCP_GEMINI_API_KEY=

# Gemini 임베딩 모델.
DOCS_MCP_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Google Drive 문서 검색 (search_documents / get_document / refresh_index) ---
# 검색 범위로 고정할 Drive 폴더 ID 1개. 하위 폴더까지 재귀 탐색한다.
# 이 폴더를 서비스 계정 이메일에 "뷰어"로 공유해두면 팀원 개별 OAuth 로그인이 필요 없다.
# 비워두면 Drive 소스가 비활성화된다.
DOCS_MCP_DRIVE_FOLDER_ID=

# 서비스 계정 키 파일 경로. DOCS_MCP_DRIVE_SERVICE_ACCOUNT_JSON 과 둘 중 하나만 있으면 된다.
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_FILE=

# 서비스 계정 키를 파일 대신 JSON 문자열로 직접 넣을 때 사용(파일 경로보다 우선).
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_JSON=

# --- Notion 문서 검색 ---
# Notion Integration Token. 비워두면 Notion 소스가 비활성화된다.
# 검색 대상 페이지를 해당 Integration 에 "연결"해두어야 한다.
DOCS_MCP_NOTION_TOKEN=

# 검색 범위를 특정 데이터베이스 하위로 한정할 때 지정. 비우면 통합이 접근 가능한
# 워크스페이스 전체 페이지가 대상이 된다.
DOCS_MCP_NOTION_DATABASE_ID=

# Notion REST API 버전(`Notion-Version` 헤더 값).
DOCS_MCP_NOTION_VERSION=2022-06-28

# --- 문서 소스 공통 ---
# Drive/Notion HTTP 요청 타임아웃(초).
DOCS_MCP_DOCUMENT_SOURCE_TIMEOUT_SECONDS=15.0

# 본문 fetch 시 잘라낼 최대 문자 수(과대 응답으로 인한 메모리/토큰 폭증 방지).
DOCS_MCP_DOCUMENT_FETCH_MAX_CHARS=200000
