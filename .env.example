# PostgreSQL(+pgvector) 연결 URL. docker-compose의 기본 postgres 서비스와 일치.
DOCS_MCP_DATABASE_URL=postgresql+psycopg://docs_mcp:docs_mcp@localhost:5432/docs_mcp

# 하이브리드 검색에서 키워드 점수 가중치 (0.0=벡터만, 1.0=키워드만).
# 레거시 SearchService 하이브리드 전용이며, search_endpoints 의 rrf 전략(아래)에는
# 적용되지 않는다(RRF 는 등수 기반 스케일 불변이라 가중합 개념이 붙지 않는다).
DOCS_MCP_HYBRID_ALPHA=0.4

# search_endpoints 검색 전략: rrf(기본, 키워드+벡터 항상 병렬 실행 후 순위 융합) |
# fallback(키워드 우선, 0건일 때만 벡터 — RRF 회귀 시 즉시 되돌리는 롤백 스위치).
# RRF 상수 K=60 은 평가셋 없이 튜닝 근거가 없어 코드 상수로 고정하고 여기엔 노출하지 않는다.
DOCS_MCP_SEARCH_STRATEGY=rrf

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR).
DOCS_MCP_LOG_LEVEL=INFO

# 로컬 CPU 임베딩 모델(sentence-transformers). 384차원 고정 — 다른 차원 모델로
# 바꾸면 api_chunk.embedding(pgvector) 컬럼도 alembic 마이그레이션(컬럼
# 재생성 + 재색인)이 필요하다. 최초 실행 시 HuggingFace 에서 모델을
# 내려받는다(캐시 경로는 표준 HF_HOME 사용).
DOCS_MCP_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# 임베딩 백엔드: local(기본, 실제 의미 유사도) | hash(결정적 해시, 모델
# 다운로드 없음 — 테스트/오프라인/모델 로드 실패 폴백용).
DOCS_MCP_EMBEDDING_BACKEND=local

# --- Google Drive 문서 검색 (search_documents / get_document / refresh_index) ---
# 레거시/기본 프로젝트(project="default")용 Drive 폴더 ID 1개. 하위 폴더까지
# 재귀 탐색한다. 이 폴더를 서비스 계정 이메일에 "뷰어"로 공유해두면 팀원 개별
# OAuth 로그인이 필요 없다. 비워두면 기본 프로젝트에 Drive 소스가 없는 채로
# 시작한다. 프로젝트별 폴더는 register_drive_source 도구로 등록한다.
DOCS_MCP_DRIVE_FOLDER_ID=

# 서비스 계정 키 파일 경로. DOCS_MCP_DRIVE_SERVICE_ACCOUNT_JSON 과 둘 중 하나만 있으면 된다.
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_FILE=

# 서비스 계정 키를 파일 대신 JSON 문자열로 직접 넣을 때 사용(파일 경로보다 우선).
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_JSON=

# --- Notion 문서 검색 ---
# Notion Integration Token. 비워두면 Notion 소스가 비활성화된다.
# 검색 대상 페이지를 해당 Integration 에 "연결"해두어야 한다.
DOCS_MCP_NOTION_TOKEN=

# 레거시/기본 프로젝트(project="default")용 Notion 데이터베이스 ID. 비우면
# 통합이 접근 가능한 워크스페이스 전체 페이지가 대상이 된다. 프로젝트별
# 데이터베이스는 register_notion_source 도구로 등록한다.
DOCS_MCP_NOTION_DATABASE_ID=

# Notion REST API 버전(`Notion-Version` 헤더 값).
DOCS_MCP_NOTION_VERSION=2022-06-28

# --- 문서 소스 공통 ---
# Drive/Notion HTTP 요청 타임아웃(초).
DOCS_MCP_DOCUMENT_SOURCE_TIMEOUT_SECONDS=15.0

# 본문 fetch 시 잘라낼 최대 문자 수(과대 응답으로 인한 메모리/토큰 폭증 방지).
DOCS_MCP_DOCUMENT_FETCH_MAX_CHARS=200000
