# ============================================================
# 필수 — 이 값 없이는 서버가 뜨지 않는다
# ============================================================

# PostgreSQL(+pgvector) 연결 URL. docker-compose의 기본 postgres 서비스와 일치.
DOCS_MCP_DATABASE_URL=postgresql+psycopg://docs_mcp:docs_mcp@localhost:5432/docs_mcp

# ============================================================
# 선택 — Google Drive / Notion 문서 검색을 쓸 때만
# (search_documents / get_document / refresh_index 도구용)
# 아래를 전부 비워두면 OpenAPI·Markdown 등 등록 문서 검색만 동작한다.
#
# 자격증명(이 섹션)만 .env 에 둔다. "어떤 폴더/페이지를 볼지"는 여기 넣지 않고 
# register_drive_source / register_notion_source / register_notion_page
# 도구로 등록한다 — project 별로 여러 개 등록 가능하고, 서버 재시작 없이
# 바로 반영된다(.env 는 재시작해야 반영됨).
# ============================================================

# --- Google Drive ---
# 서비스 계정 키. 파일 경로 또는 JSON 문자열 중 하나만 있으면 된다(JSON 우선).
# 검색 대상 폴더를 이 서비스 계정 이메일에 "뷰어"로 공유해두면 팀원 개별
# OAuth 로그인이 필요 없다.
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_FILE=
DOCS_MCP_DRIVE_SERVICE_ACCOUNT_JSON=

# --- Notion ---
# Notion Integration Token. 비워두면 Notion 소스가 비활성화된다.
# 검색 대상 페이지를 해당 Integration 에 "연결"해두어야 한다.
DOCS_MCP_NOTION_TOKEN=

# ============================================================
# 레거시 — project 개념 도입 전 하위호환용. 
# 새로 시작한다면 비워두고 위 도구(register_drive_source 등)로 등록할 것. 
# project="default" 전용 슬롯 1개뿐이며, 값을 바꿔도 서버 재시작 전까지 반영되지 않는다.
# ============================================================

# 기본 프로젝트(project="default")용 Drive 폴더 ID 1개. 하위 폴더까지 재귀
# 탐색한다.
DOCS_MCP_DRIVE_FOLDER_ID=

# 기본 프로젝트(project="default")용 Notion 데이터베이스 ID. 
# 비우면 통합이 접근 가능한 워크스페이스 전체 페이지가 대상이 된다.
DOCS_MCP_NOTION_DATABASE_ID=

# 기본 프로젝트용 Notion 허브 페이지 ID. 바로 아래 1단계 하위 페이지가 대상이 된다.
# database_id 와 동시에 설정하면 이 값(page)이 우선합니다.
DOCS_MCP_NOTION_PAGE_ID=

# ============================================================
# 튜닝 — 기본값으로 두어도 정상 동작한다
# ============================================================

# 로컬 CPU 임베딩 모델(sentence-transformers). 
# 384차원 고정 — 다른 차원 모델로 바꾸면 api_chunk.embedding(pgvector) 컬럼도 
# alembic 마이그레이션(컬럼 재생성 + 재색인)이 필요하다. 
# 최초 실행 시 HuggingFace 에서 모델을 내려받는다(캐시 경로는 표준 HF_HOME 사용).
DOCS_MCP_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# 임베딩 백엔드: local(기본, 실제 의미 유사도) | hash(결정적 해시,
#  모델 다운로드 없음 — 테스트/오프라인/모델 로드 실패 폴백용).
DOCS_MCP_EMBEDDING_BACKEND=local

# search_endpoints 검색 전략: rrf(기본, 키워드+벡터 항상 병렬 실행 후 순위 융합) |
# fallback(키워드 우선, 0건일 때만 벡터 — RRF 회귀 시 즉시 되돌리는 롤백 스위치).
# RRF 상수 K=60 은 평가셋 없이 튜닝 근거가 없어 코드 상수로 고정하고 여기엔 노출하지 않는다.
DOCS_MCP_SEARCH_STRATEGY=rrf

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR).
DOCS_MCP_LOG_LEVEL=INFO

# Drive/Notion HTTP 요청 타임아웃(초).
DOCS_MCP_DOCUMENT_SOURCE_TIMEOUT_SECONDS=15.0

# 본문 fetch 시 잘라낼 최대 문자 수(과대 응답으로 인한 메모리/토큰 폭증 방지).
DOCS_MCP_DOCUMENT_FETCH_MAX_CHARS=200000

# Notion REST API 버전(`Notion-Version` 헤더 값). 바꿀 일이 거의 없다.
DOCS_MCP_NOTION_VERSION=2022-06-28
