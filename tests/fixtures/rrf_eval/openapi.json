{
  "openapi": "3.0.3",
  "info": { "title": "평가용 통합 API", "version": "1.0.0" },
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "로그인",
        "description": "이메일과 비밀번호로 로그인한다",
        "tags": ["auth"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "로그아웃",
        "description": "현재 세션을 종료한다",
        "tags": ["auth"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/auth/password/reset-request": {
      "post": {
        "operationId": "requestPasswordReset",
        "summary": "비밀번호 재설정 요청",
        "description": "비밀번호를 잊어버린 사용자에게 재설정 링크를 이메일로 보낸다",
        "tags": ["auth"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/auth/password/reset-confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "summary": "비밀번호 재설정 확인",
        "description": "재설정 토큰과 새 비밀번호로 비밀번호를 변경한다",
        "tags": ["auth"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "세션 상태 확인",
        "description": "현재 로그인 상태 여부를 확인한다",
        "tags": ["auth"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "summary": "Create user account",
        "description": "Register a new user account with email and password",
        "tags": ["user"],
        "responses": { "200": { "description": "ok" } }
      },
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "description": "List all registered users",
        "tags": ["user"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users/{userId}": {
      "get": {
        "operationId": "getUserById",
        "summary": "Get user by id",
        "description": "Retrieve a single user's profile by id",
        "tags": ["user"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "patch": {
        "operationId": "updateUser",
        "summary": "Update user profile",
        "description": "Update a user's profile fields",
        "tags": ["user"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "operationId": "deleteUser",
        "summary": "Delete user account",
        "description": "Permanently delete a user account",
        "tags": ["user"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "신규 주문 생성",
        "description": "장바구니 내용을 기반으로 새 주문을 생성한다",
        "tags": ["order"],
        "responses": { "200": { "description": "ok" } }
      },
      "get": {
        "operationId": "listOrders",
        "summary": "주문 목록 조회",
        "description": "사용자의 전체 주문 내역을 조회한다. status 파라미터로 필터링 가능",
        "tags": ["order"],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrderById",
        "summary": "주문 상세 조회",
        "description": "주문 ID로 단일 주문의 상세 정보를 조회한다",
        "tags": ["order"],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      },
      "delete": {
        "operationId": "cancelOrder",
        "summary": "주문 취소",
        "description": "배송 전 주문을 취소한다",
        "tags": ["order"],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/subscriptions/{subId}/cancel": {
      "post": {
        "operationId": "cancelSubscription",
        "summary": "구독 해지",
        "description": "사용자의 정기 구독을 해지 처리한다",
        "tags": ["billing"],
        "parameters": [
          { "name": "subId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/billing/refund": {
      "post": {
        "operationId": "requestRefund",
        "summary": "환불 요청",
        "description": "결제된 금액에 대한 환불을 요청한다",
        "tags": ["billing"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/billing/invoices": {
      "get": {
        "operationId": "listInvoices",
        "summary": "청구서 목록 조회",
        "description": "사용자의 청구서 내역을 조회한다",
        "tags": ["billing"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "서버 상태 확인",
        "description": "서버와 의존 서비스의 상태(status)를 점검한다",
        "tags": ["ops"],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "상품 목록 조회",
        "description": "등록된 상품 목록을 조회한다",
        "tags": ["product"],
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/products/{productId}": {
      "get": {
        "operationId": "getProductById",
        "summary": "상품 상세 조회",
        "description": "상품 ID로 단일 상품의 상세 정보를 조회한다",
        "tags": ["product"],
        "parameters": [
          { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
